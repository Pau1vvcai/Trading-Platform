{
  "title": "Trading Platform · Stage 2",
  "uid": "trading-stage-2",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    { "type": "stat", "title": "实时事件", "gridPos": {"x":0,"y":0,"w":6,"h":5}, "targets": [{"expr":"trading_realtime_events_total","legendFormat":"events"}] },
    { "type": "stat", "title": "导入行情", "gridPos": {"x":6,"y":0,"w":6,"h":5}, "targets": [{"expr":"trading_market_data_imported_bars_total","legendFormat":"bars"}] },
    { "type": "stat", "title": "回测任务", "gridPos": {"x":12,"y":0,"w":6,"h":5}, "targets": [{"expr":"trading_backtest_submitted_total","legendFormat":"jobs"}] },
    { "type": "timeseries", "title": "HTTP P95 延迟", "gridPos": {"x":0,"y":5,"w":12,"h":8}, "targets": [{"expr":"histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket[5m])) by (le))","legendFormat":"p95"}] },
    { "type": "timeseries", "title": "HTTP 5xx", "gridPos": {"x":12,"y":5,"w":12,"h":8}, "targets": [{"expr":"sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[5m]))","legendFormat":"5xx/s"}] }
  ]
}
